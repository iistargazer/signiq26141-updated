{
  "installCommand": "npm install --prefix sih26141/frontend",
  "buildCommand": "npm run build --prefix sih26141/frontend",
  "outputDirectory": "sih26141/frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://sih26141-quantum-pipeline.onrender.com/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
